# Supabase — get these from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# AdSense — enable ads only after your site is approved
NEXT_PUBLIC_ENABLE_ADS=false
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_HOMEPAGE_TOP=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_HOMEPAGE_INLINE=2345678901
NEXT_PUBLIC_ADSENSE_SLOT_STORE_INLINE=3456789012

# Google Analytics 4 — create a property at analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase service role key (server-only, NOT NEXT_PUBLIC_)
# Get from Supabase > Settings > API > service_role key
# Used for server-side store visit tracking
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional Google verification meta tag for AdSense/Search Console
GOOGLE_SITE_VERIFICATION=your-google-site-verification-token
